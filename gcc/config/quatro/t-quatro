LIBGCC1_TEST =

# OTI-4110 change added to map DF, SF and DI to SI
# refer to this link for more details http://www.ecoscentric.com/devzone/gcc-3.2.1-h8300.patch

TARGET_LIBGCC2_CFLAGS = -DDI=SI -DDF=SF

# Eliminate default "-g" from debug flags to turn off debug build of
# the libgcc library to make it smaller.  (The user won't have access
# to the source files anyway.)
#
# Also add "-P" to prevent generation of linemarkers.  Linemarkers
# also contain the source file name, which screws up the build of
# our assembler sources.
#
LIBGCC2_DEBUG_CFLAGS =-P
