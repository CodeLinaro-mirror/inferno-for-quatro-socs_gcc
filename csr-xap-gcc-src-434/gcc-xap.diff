+                    rtx fset_src = SET_SRC(fset);
+                              
+                    if(REG_P(fset_src) &&
+                       REGNO(fset_src) == REGNO(dst)) {
+                        dst_dest = SET_DEST(fset);
+                        break;
+                    }
+                }
